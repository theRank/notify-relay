{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "notify-relay",
    "main": "src/platforms/cloudflare.ts",
    "compatibility_date": "2026-10-01",
    "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
    "workers_dev": false,
    "preview_urls": false,
    // Keeps what the relay logs of each request, and Cloudflare's own line per invocation with its URL:
    // the query names channels, and tokens travel in a header
    "observability": { "enabled": true }
}
